<mujoco model="sea-nav winding rough course">
  <include file="go2.xml"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <statistic center="10 0 0.5" extent="12"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.1 0.1" width="512" height="3072"/>
    <material name="floor" rgba="0.25 0.35 0.28 1"/>
    <hfield name="rough_large" file="../height_field_large.png" size="12 7.5 .18 .12"/>
  </asset>
  <worldbody>
    <light pos="4 -4 8" dir="-0.2 0.2 -1" directional="true" diffuse="0.8 0.8 0.8" specular="0.4 0.4 0.4"/>
    <site name="winding_spawn" pos="0 0 .45" size=".08" rgba="0.1 1 0.1 0.8"/>
    <geom name="floor" type="plane" size="30 8 .05" material="floor"/>
    <geom name="rough_terrain" type="hfield" hfield="rough_large" pos="10 0 0"/>

    <!-- Straight rough corridor: the policy only needs to avoid interior boxes. -->
    <geom name="wall_left" type="box" pos="11 2.5 .6" size="11 .12 .6"/>
    <geom name="wall_right" type="box" pos="11 -2.5 .6" size="11 .12 .6"/>

    <!-- Alternating interior obstacles leave a clear side passage. -->
    <geom name="course_box_0" type="box" pos="4 0.9 .35" size=".3 .3 .35"/>
    <geom name="course_box_1" type="box" pos="8 -0.9 .35" size=".3 .3 .35"/>
    <geom name="course_box_2" type="box" pos="12 0.9 .35" size=".3 .3 .35"/>
    <geom name="course_box_3" type="box" pos="16 -0.9 .35" size=".3 .3 .35"/>
  </worldbody>
</mujoco>
